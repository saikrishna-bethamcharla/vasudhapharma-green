# Prevent script execution in uploads directory
<FilesMatch "(?i)\.(php[0-9]?|phtml|pht|phps|phar|sh|pl|py|cgi|asp|aspx|exe|bat|cmd|shtml|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to configuration overrides and dotfiles
<FilesMatch "(?i)^(\.htaccess|\.user\.ini|\.env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent search engines from indexing uploaded files and prevent MIME-sniffing
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
