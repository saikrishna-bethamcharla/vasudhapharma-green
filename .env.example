# ==============================================================================
# Vasudha Pharma Chem Limited — Environment Configuration Template
# Copy this file to .env and set your production secrets.
# IMPORTANT: .env is denied from public HTTP access via .htaccess.
# ==============================================================================

# Application Environment (production / development)
VP_APP_ENV=production

# Admin & Notification Email Recipients (comma-separated if multiple)
VP_ADMIN_EMAIL=wisdom@vasudhapharma.com
VP_HR_EMAIL=wisdom@vasudhapharma.com

# SMTP Relay Configuration (Optional - falls back to PHP native mail())
VP_SMTP_HOST=
VP_SMTP_PORT=587
VP_SMTP_USER=
VP_SMTP_PASS=
VP_SMTP_FROM=noreply@vasudhapharma.com

# Zoho CRM WebToLead Forwarding
VP_ZOHO_CRM_URL=https://crm.zoho.in/crm/WebToLeadForm

# Rate Limiter Max Entries
VP_RATE_LIMIT_STORE_MAX=400
